# ─────────────────────────────────────────────────────────────
# EduCore Nexus — Environment Configuration
# Copy to backend/.env and ai-service/.env as needed
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_mgmt?schema=public"

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000

# ── JWT Auth ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=d28ef57d81f1a2fb0f607a96074610eb64cfa7dfe07d6ffc237b41eaa1e50641
JWT_REFRESH_SECRET=a164b704388121da6af75ff49b6dbd675ae2dfd5551e3d7dd81eea7bf217a9ad
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google Calendar OAuth ────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Google Calendar API, then set these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Optional: service account for server-to-server access
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=

# ── Redis (optional; app works without it) ───────────────────
REDIS_URL=redis://localhost:6379

# ── Email / SMTP (optional) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduCore Nexus <noreply@educore.com>"

# ── Storage (optional) ───────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Security / misc ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_SWAGGER=true
LOG_LEVEL=info

# ── Frontend (frontend/.env.local) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── AI Service (ai-service/.env) ─────────────────────────────
# Shared secret that must match AI_API_KEY in backend env
AI_API_KEY=dev-key-change-me
# Optional: enable LLM responses via Jina AI
JINA_API_KEY=
